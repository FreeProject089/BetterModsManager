{
  "id": "bmm-logo",
  "name": "BMM Logo",
  "author": "BMM Team",
  "description": "The colours of the BMM logo: its pale grey canvas, ink-black shapes and signal yellow. The logo itself replaces Tasky everywhere the mascot appears.",
  "brand": { "mark": "logo" },
  "mode": "light",
  "vars": {
    "--bmm-bg-base": "#ececec",
    "--bmm-bg-elevated": "#f8f8f8",
    "--bmm-bg-overlay": "#ffffff",
    "--bmm-bg-sidebar": "#e4e4e4",
    "--bmm-bg-titlebar": "#e4e4e4",
    "--bmm-titlebar-bg": "#e4e4e4",
    "--bmm-loader-bg": "#ececec",
    "--bmm-bg-hover": "rgba(26,26,26,0.05)",
    "--bmm-border": "rgba(26,26,26,0.10)",
    "--bmm-border-hover": "rgba(26,26,26,0.20)",
    "--bmm-border-accent": "rgba(214,171,0,0.65)",
    "--bmm-text-primary": "#1a1a1a",
    "--bmm-text-secondary": "#2e2e2e",
    "--bmm-text-muted": "#4a4a4a",
    "--bmm-text-on-accent": "#1a1a1a",
    "--bmm-btn-primary-text": "#1a1a1a",
    "--bmm-brand-better": "#1a1a1a",
    "--bmm-brand-mm": "#1a1a1a",
    "--bmm-wordmark-better": "#1a1a1a",
    "--bmm-wordmark-mm": "#1a1a1a",
    "--bmm-wordmark-highlight": "rgba(255,204,0,0.9)",
    "--bmm-cyan": "#0e7490",
    "--bmm-success": "#15803d",
    "--bmm-warning": "#a16207",
    "--bmm-danger": "#c81e1e",
    "--bmm-accent": "#ffcc00",
    "--bmm-accent-dim": "rgba(255,204,0,0.28)",
    "--bmm-accent-r": "255",
    "--bmm-accent-g": "204",
    "--bmm-accent-b": "0",
    "--bmm-accent-glow": "0 0 18px rgba(255,204,0,0.45)",
    "--bmm-radius-card": "16px",
    "--bmm-radius-btn": "12px",
    "--bmm-radius-input": "10px",
    "--bmm-radius-chip": "999px",
    "--bmm-shadow-card": "0 1px 3px rgba(0,0,0,0.07), 0 1px 2px rgba(0,0,0,0.04)",
    "--bmm-shadow-modal": "0 14px 44px rgba(0,0,0,0.16)",
    "--bmm-card-glow": "0 0 0 transparent",
    "--bmm-card-hover-lift": "-1px",
    "--bmm-surface-r": "26",
    "--bmm-surface-g": "26",
    "--bmm-surface-b": "26",
    "--bmm-s10": "rgba(26,26,26,0.10)",
    "--bmm-s20": "rgba(26,26,26,0.20)",
    "--bmm-color-scheme": "light",
    "--bmm-tasky-bubble-bg": "#ffffff",
    "--bmm-tasky-bubble-text": "#1a1a1a",
    "--bmm-tasky-bubble-border": "rgba(255,204,0,0.75)"
  },
  "global_css": ".btn-primary{font-weight:700}\n::selection{background:rgba(255,204,0,0.55);color:#1a1a1a}\n.nav-item.active,.nav-item.active .nav-label,.nav-item.active .nav-icon,.nav-badge.show{color:var(--bmm-text-primary)}\n.lm-link,.lm-label{color:#6b5000}"
}
