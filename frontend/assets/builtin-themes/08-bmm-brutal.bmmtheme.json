{
  "id": "bmm-brutal",
  "name": "Brutalist",
  "author": "BMM Team",
  "description": "Neo-brutalist — warm paper canvas, zero rounding, thin ink borders and chunky offset shadows on cards. An orange accent.",
  "mode": "light",
  "vars": {
    "--bmm-bg-base": "#e7e3d8",
    "--bmm-bg-elevated": "#fcfbf6",
    "--bmm-bg-overlay": "#fcfbf6",
    "--bmm-bg-sidebar": "#f0ece1",
    "--bmm-bg-titlebar": "#fcfbf6",
    "--bmm-titlebar-bg": "#fcfbf6",
    "--bmm-loader-bg": "#e7e3d8",
    "--bmm-border": "#111111",
    "--bmm-border-hover": "#000000",
    "--bmm-border-accent": "#e8590c",
    "--bmm-text-primary": "#111111",
    "--bmm-text-secondary": "#2a2a2a",
    "--bmm-text-muted": "#3e3e3e",
    "--bmm-success": "#1a7f37",
    "--bmm-warning": "#b45309",
    "--bmm-danger": "#c92a2a",
    "--bmm-cyan": "#0c7489",
    "--bmm-tasky-bubble-bg": "#faf8f2",
    "--bmm-tasky-bubble-text": "#111111",
    "--bmm-tasky-bubble-border": "#111111",
    "--bmm-card-glow": "0 0 0 transparent",
    "--bmm-card-hover-lift": "0px",
    "--bmm-shadow-card": "4px 4px 0 #111111",
    "--bmm-shadow-modal": "8px 8px 0 #111111",
    "--bmm-radius-card": "0px",
    "--bmm-radius-btn": "0px",
    "--bmm-radius-input": "0px",
    "--bmm-radius-chip": "0px",
    "--bmm-surface-r": "0",
    "--bmm-surface-g": "0",
    "--bmm-surface-b": "0",
    "--bmm-s02": "rgba(0,0,0,0.03)",
    "--bmm-s03": "rgba(0,0,0,0.04)",
    "--bmm-s04": "rgba(0,0,0,0.05)",
    "--bmm-s05": "rgba(0,0,0,0.06)",
    "--bmm-s06": "rgba(0,0,0,0.07)",
    "--bmm-s07": "rgba(0,0,0,0.08)",
    "--bmm-s08": "rgba(0,0,0,0.09)",
    "--bmm-s09": "rgba(0,0,0,0.10)",
    "--bmm-s10": "rgba(0,0,0,0.11)",
    "--bmm-s12": "rgba(0,0,0,0.13)",
    "--bmm-s15": "rgba(0,0,0,0.16)",
    "--bmm-s20": "rgba(0,0,0,0.22)",
    "--bmm-glass-bg": "rgba(0,0,0,0.04)",
    "--bmm-glass-border": "#111111",
    "--bmm-bg-hover": "rgba(0,0,0,0.06)",
    "--bmm-color-scheme": "light",
    "--bmm-accent": "#e8590c",
    "--bmm-accent-dim": "rgba(232,89,12,0.18)",
    "--bmm-accent-r": "232",
    "--bmm-accent-g": "89",
    "--bmm-accent-b": "12",
    "--bmm-accent-glow": "0 0 0 transparent"
  },
  "global_css": ".glass-card,.modpack-card,.profile-card{box-shadow:4px 4px 0 var(--bmm-border);transition:transform .12s ease, box-shadow .12s ease}\n.glass-card:hover,.modpack-card:hover{transform:translate(-2px,-2px);box-shadow:6px 6px 0 var(--bmm-border)}\n.btn-primary{font-weight:800;box-shadow:3px 3px 0 var(--bmm-border)}\n.btn-primary:hover{transform:translate(-1px,-1px);box-shadow:4px 4px 0 var(--bmm-border)}\nh1,h2,h3,.card-title{font-weight:900;letter-spacing:-.01em}"
}