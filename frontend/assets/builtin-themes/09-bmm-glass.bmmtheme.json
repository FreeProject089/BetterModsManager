  "global_css": "body{background:radial-gradient(1200px 820px at 12% -12%, rgba(60,90,200,0.45) 0%, transparent 55%),radial-gradient(1000px 720px at 112% 8%, rgba(150,70,210,0.4) 0%, transparent 55%),radial-gradient(900px 700px at 90% 115%, rgba(40,160,170,0.3) 0%, transparent 55%),#0a0c12 !important;background-attachment:fixed}\n.glass-card,.modpack-card,.profile-card{backdrop-filter:blur(20px) saturate(160%);-webkit-backdrop-filter:blur(20px) saturate(160%);box-shadow:0 10px 34px rgba(0,0,0,0.42), inset 0 1px 0 rgba(255,255,255,0.12)}\n.bmm-sidebar,.sidebar,#app-sidebar,.titlebar{backdrop-filter:blur(20px) saturate(150%);-webkit-backdrop-filter:blur(20px) saturate(150%)}\n.btn-primary{box-shadow:0 6px 18px rgba(124,140,255,0.45)}"
