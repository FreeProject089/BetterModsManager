{
  "id": "bmm-vscode",
  "name": "VS Code",
  "author": "BMM Team",
  "description": "Visual Studio Code “Dark Modern” — charcoal surfaces, 1 px borders, the blue focus accent, small square corners.",
  "vars": {
    "--bmm-bg-base": "#1f1f1f",
    "--bmm-bg-elevated": "#252526",
    "--bmm-bg-overlay": "#202020",
    "--bmm-bg-sidebar": "#181818",
    "--bmm-bg-titlebar": "#181818",
    "--bmm-titlebar-bg": "#181818",
    "--bmm-loader-bg": "#1f1f1f",
    "--bmm-bg-hover": "rgba(255,255,255,0.06)",
    "--bmm-border": "#2b2b2b",
    "--bmm-border-hover": "#3c3c3c",
    "--bmm-border-accent": "rgba(0,120,212,0.4)",
    "--bmm-text-primary": "#cccccc",
    "--bmm-text-secondary": "#b4b4b4",
    "--bmm-text-muted": "#8b8b8b",
    "--bmm-text-on-accent": "#ffffff",
    "--bmm-btn-primary-text": "#ffffff",
    "--bmm-cyan": "#4fc1ff",
    "--bmm-success": "#89d185",
    "--bmm-warning": "#cca700",
    "--bmm-danger": "#f14c4c",
    "--bmm-accent": "#0078d4",
    "--bmm-accent-dim": "rgba(0,120,212,0.18)",
    "--bmm-accent-r": "0",
    "--bmm-accent-g": "120",
    "--bmm-accent-b": "212",
    "--bmm-accent-glow": "0 0 20px rgba(0,120,212,0.35)",
    "--bmm-radius-card": "6px",
    "--bmm-radius-btn": "3px",
    "--bmm-radius-input": "3px",
    "--bmm-radius-chip": "4px",
    "--bmm-shadow-card": "0 2px 8px rgba(0,0,0,0.36)",
    "--bmm-shadow-modal": "0 8px 24px rgba(0,0,0,0.5)",
    "--bmm-card-glow": "0 0 0 transparent",
    "--bmm-card-hover-lift": "0px",
    "--bmm-surface-r": "255",
    "--bmm-surface-g": "255",
    "--bmm-surface-b": "255",
    "--bmm-s10": "rgba(255,255,255,0.10)",
    "--bmm-s20": "rgba(255,255,255,0.20)",
    "--bmm-color-scheme": "dark",
    "--bmm-tasky-bubble-bg": "#252526",
    "--bmm-tasky-bubble-text": "#cccccc",
    "--bmm-tasky-bubble-border": "rgba(0,120,212,0.3)"
  },
  "global_css": "body{font-family:'Segoe UI','Inter',system-ui,sans-serif}\n.sidebar{border-right:1px solid var(--bmm-border)}\n.glass-card,.modpack-card,.profile-card{border:1px solid var(--bmm-border);backdrop-filter:none}\n.glass-card:hover,.modpack-card:hover{border-color:var(--bmm-border-hover)}\n.btn-primary{font-weight:500}\ninput.input:focus,textarea.input:focus,select.input:focus{outline:1px solid var(--bmm-accent);outline-offset:-1px}"
}
