{
  "id": "bmm-macos",
  "name": "Cobalt",
  "author": "BMM Team",
  "description": "Graphite dark with hairline borders, 10 px corners and a bright cobalt-blue accent.",
  "vars": {
    "--bmm-bg-base": "#1e1e1e",
    "--bmm-bg-elevated": "#2a2a2c",
    "--bmm-bg-overlay": "#2c2c2e",
    "--bmm-bg-sidebar": "#232325",
    "--bmm-bg-titlebar": "#232325",
    "--bmm-titlebar-bg": "rgba(35,35,37,0.92)",
    "--bmm-loader-bg": "#1e1e1e",
    "--bmm-bg-hover": "rgba(255,255,255,0.07)",
    "--bmm-border": "rgba(255,255,255,0.09)",
    "--bmm-border-hover": "rgba(255,255,255,0.18)",
    "--bmm-border-accent": "rgba(10,132,255,0.4)",
    "--bmm-text-primary": "#f5f5f7",
    "--bmm-text-secondary": "#d1d1d6",
    "--bmm-text-muted": "#98989d",
    "--bmm-text-on-accent": "#ffffff",
    "--bmm-btn-primary-text": "#ffffff",
    "--bmm-cyan": "#64d2ff",
    "--bmm-success": "#30d158",
    "--bmm-warning": "#ffd60a",
    "--bmm-danger": "#ff453a",
    "--bmm-accent": "#0a84ff",
    "--bmm-accent-dim": "rgba(10,132,255,0.18)",
    "--bmm-accent-r": "10",
    "--bmm-accent-g": "132",
    "--bmm-accent-b": "255",
    "--bmm-accent-glow": "0 0 20px rgba(10,132,255,0.35)",
    "--bmm-radius-card": "12px",
    "--bmm-radius-btn": "8px",
    "--bmm-radius-input": "7px",
    "--bmm-radius-chip": "14px",
    "--bmm-shadow-card": "0 1px 2px rgba(0,0,0,0.35), 0 8px 24px rgba(0,0,0,0.28)",
    "--bmm-shadow-modal": "0 24px 70px rgba(0,0,0,0.55)",
    "--bmm-card-glow": "0 0 0 transparent",
    "--bmm-card-hover-lift": "-1px",
    "--bmm-surface-r": "255",
    "--bmm-surface-g": "255",
    "--bmm-surface-b": "255",
    "--bmm-s10": "rgba(255,255,255,0.10)",
    "--bmm-s20": "rgba(255,255,255,0.20)",
    "--bmm-glass-bg": "rgba(255,255,255,0.045)",
    "--bmm-glass-border": "rgba(255,255,255,0.10)",
    "--bmm-color-scheme": "dark",
    "--bmm-tasky-bubble-bg": "rgba(44,44,46,0.94)",
    "--bmm-tasky-bubble-text": "#f5f5f7",
    "--bmm-tasky-bubble-border": "rgba(10,132,255,0.3)"
  },
  "global_css": "body{font-family:-apple-system,'SF Pro Text','SF Pro Display','Inter',system-ui,sans-serif;letter-spacing:-0.005em}\n.glass-card,.modpack-card,.profile-card{box-shadow:var(--bmm-shadow-card), inset 0 1px 0 rgba(255,255,255,0.05)}\n.btn-primary{background:linear-gradient(180deg,#2f95ff,#0a84ff);box-shadow:0 1px 1px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.18)}\n.btn-primary:hover{background:linear-gradient(180deg,#3b9dff,#1a8cff)}\ninput.input:focus,textarea.input:focus,select.input:focus{box-shadow:0 0 0 3.5px rgba(10,132,255,0.35)}"
}
