{
    "name": "better-mods-manager",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "tauri": "tauri",
        "dev": "concurrently \"npm run watch\" \"npx tauri dev --no-dev-server\"",
        "build": "node scripts/security-guard.mjs && tsc --project frontend && npx tauri build && node scripts/gen-update-manifest.mjs",
        "security-guard": "node scripts/security-guard.mjs",
        "check:i18n": "node scripts/check-i18n-parity.mjs",
        "check:colors": "node scripts/check-hardcoded-colors.mjs",
        "check:kit": "node scripts/check-kit.mjs",
        "check:docs": "node scripts/check-docs-xref.mjs",
        "check:encoding": "node scripts/check-encoding.mjs",
        "sync-docs": "node scripts/sync-docs.mjs",
        "ci": "node scripts/security-guard.mjs && node scripts/check-i18n-parity.mjs && node scripts/check-hardcoded-colors.mjs && node scripts/check-encoding.mjs && tsc --project frontend && node scripts/check-kit.mjs && node scripts/check-docs-xref.mjs && node scripts/sync-docs.mjs --check",
        "gen-manifest": "node scripts/gen-update-manifest.mjs",
        "typecheck": "tsc --project frontend --noEmit",
        "watch": "tsc --project frontend --watch",
        "compile": "tsc --project frontend",
        "test:i18n": "python tests/i18n_parity.test.py"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2",
        "concurrently": "^9.2.1",
        "prisma": "^5.22.0",
        "puppeteer-core": "^25.0.4",
        "rrweb": "^2.0.1",
        "typescript": "^5.7"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "@tanstack/query-core": "^5.91.2",
        "@tauri-apps/api": "^2",
        "cheerio": "^1.2.0",
        "dompurify": "^3.4.11"
    }
}
