{
    "build": {
        "beforeDevCommand": "",
        "beforeBuildCommand": "",
        "devPath": "../frontend",
        "distDir": "../frontend",
        "withGlobalTauri": true
    },
    "package": {
        "productName": "Better Mod Manager",
        "version": "0.9.11"
    },
    "tauri": {
        "allowlist": {
            "all": false,
            "dialog": {
                "open": true,
                "save": true,
                "confirm": true,
                "ask": true,
                "message": true
            },
            "fs": {
                "all": true,
                "scope": [
                    "$APP/**",
                    "$APPDATA/**",
                    "$HOME/**",
                    "$RESOURCE/**"
                ]
            },
            "path": {
                "all": true
            },
            "shell": {
                "open": true,
                "sidecar": true,
                "scope": [
                    { "name": "binaries/bmm-mcp-server", "sidecar": true }
                ]
            },
            "window": {
                "all": true
            },
            "notification": {
                "all": true
            },
            "protocol": {
                "asset": true,
                "assetScope": [
                    "$APP/**",
                    "$APPDATA/**",
                    "$RESOURCE/**"
                ]
            }
        },
        "bundle": {
            "active": true,
            "targets": "all",
            "identifier": "com.bettermm.app",
            "icon": [
                "icons/32x32.png",
                "icons/128x128.png",
                "icons/128x128@2x.png",
                "icons/icon.icns",
                "icons/icon.ico"
            ],
            "resources": [
                "../app.cfg",
                "../LICENSE.md",
                "../EULA.md",
                "../EULA_FR.md",
                "../frontend/Lang"
            ],
            "externalBin": [
                "binaries/bmm-mcp-server"
            ],
            "windows": {
                "certificateThumbprint": null,
                "digestAlgorithm": "sha256",
                "timestampUrl": "",
                "nsis": {
                    "license": "nsis/license.txt"
                },
                "wix": {
                    "license": "nsis/license.txt"
                }
            }
        },
        "security": {
            "csp": null
        },
        "cli": {
            "description": "Better Mods Manager CLI",
            "longDescription": "Interface en ligne de commande pour BMM",
            "args": [
                {
                    "name": "profile",
                    "short": "p",
                    "description": "Charge un profil spécifique au démarrage",
                    "takesValue": true
                },
                {
                    "name": "server",
                    "short": "s",
                    "description": "Démarre l'application en mode Lightweight Server",
                    "takesValue": false
                }
            ]
        },
        "windows": [
            {
                "label": "main",
                "title": "Better Mod Manager",
                "width": 1480,
                "height": 960,
                "minWidth": 1024,
                "minHeight": 680,
                "resizable": true,
                "fullscreen": false,
                "decorations": false,
                "transparent": true,
                "center": true,
                "url": "index.html"
            }
        ]
    }
}