{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Better Mod Manager",
    "version": "1.0.0",
    "identifier": "com.bettermm.desktop",
    "build": {
        "beforeDevCommand": "npm run compile",
        "beforeBuildCommand": "npm run compile",
        "frontendDist": "../frontend"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "Better Mod Manager",
                "width": 1480,
                "height": 960,
                "minWidth": 1120,
                "minHeight": 680,
                "resizable": true,
                "fullscreen": false,
                "decorations": false,
                "transparent": true,
                "shadow": false,
                "center": true,
                "url": "index.html"
            }
        ],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$APP/**",
                    "$APPDATA/**",
                    "$RESOURCE/**"
                ]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "licenseFile": "nsis/license.txt",
        "resources": [
            "../app.cfg",
            "../LICENSE.md",
            "../TOS.md",
            "../TOS_FR.md",
            "../PRIVACY.md",
            "../PRIVACY_FR.md",
            "../frontend/Lang",
            "../frontend/assets/tutorial-assets",
            "../frontend/assets/links.json",
            "../frontend/assets/builtin-themes",
            "../Update"
        ],
        "externalBin": [
            "binaries/bmm-mcp-server"
        ],
        "windows": {
            "certificateThumbprint": null,
            "digestAlgorithm": "sha256",
            "timestampUrl": "",
            "webviewInstallMode": {
                "type": "downloadBootstrapper",
                "silent": true
            },
            "nsis": {},
            "wix": {}
        }
    },
    "plugins": {
        "cli": {
            "description": "Better Mods Manager CLI",
            "longDescription": "Interface en ligne de commande pour BMM",
            "args": [
                {
                    "name": "profile",
                    "short": "p",
                    "description": "Charge un profil spécifique au démarrage",
                    "takesValue": true
                },
                {
                    "name": "server",
                    "short": "s",
                    "description": "Démarre l'application en mode Lightweight Server",
                    "takesValue": false
                }
            ]
        }
    }
}
