{
    "build": {
        "beforeDevCommand": "",
        "beforeBuildCommand": "",
        "devPath": "../frontend",
        "distDir": "../frontend",
        "withGlobalTauri": true
    },
    "package": {
        "productName": "Better Mod Manager",
        "version": "0.9.5"
    },
    "tauri": {
        "allowlist": {
            "all": false,
            "dialog": {
                "open": true,
                "save": true
            },
            "fs": {
                "all": true,
                "scope": [
                    "$APP/**",
                    "$APPDATA/**",
                    "$HOME/**",
                    "$RESOURCE/**",
                    "**"
                ]
            },
            "path": {
                "all": true
            },
            "shell": {
                "open": true
            },
            "window": {
                "all": true
            },
            "notification": {
                "all": true
            }
        },
        "bundle": {
            "active": true,
            "targets": "all",
            "identifier": "com.bettermm.app",
            "icon": [
                "icons/32x32.png",
                "icons/128x128.png",
                "icons/128x128@2x.png",
                "icons/icon.icns",
                "icons/icon.ico"
            ]
        },
        "security": {
            "csp": null
        },
        "windows": [
            {
                "label": "main",
                "title": "Better Mod Manager",
                "width": 1440,
                "height": 920,
                "minWidth": 1024,
                "minHeight": 680,
                "resizable": true,
                "fullscreen": false,
                "decorations": false,
                "transparent": false,
                "center": true
            }
        ]
    }
}