// ─── the instance ────────────────────────────────────────────────────────────

/**
 * create({ dir, kind, adminPassword, downloadPassword, port })
 *
 * early(req, res, ip)      → true when it answered: rate limit, /health, /status, /admin/jobs
 * serve(req, res)          → true when it answered: /feed.xml, /feed.atom (call AFTER the gate)
 * prepareFile(req, res, absPath, stat), sendBody(req, res, body, type)
 * isPrivate(segments)      → true for bmm-server/…, which is never served
 */
function create(opts) {
    const dir = path.resolve(opts.dir);
    const kind = opts.kind || 'node';
    const startTime = Date.now();
    const privDir = path.join(dir, PRIVATE_DIR);
    const stateFile = path.join(privDir, 'jobs-state.json');
    const logFile = path.join(dir, 'server.log');
    let config = loadConfig(dir);
    let configMtime = 0;
    try { configMtime = fs.statSync(config._file).mtimeMs; } catch (_) {}
    let state = readJson(stateFile, {}) || {};
    const running = new Set();
    const buckets = new Map();
    let timer = null;

    function log(msg, level) {
        const line = '[' + new Date().toISOString() + '] [' + (level || 'JOB') + '] ' + msg;
        console.log(line);
        try { fs.appendFileSync(logFile, line + '\n'); } catch (_) {}
    }

    function saveState() {
        try { fs.mkdirSync(privDir, { recursive: true }); writeJsonAtomic(stateFile, state); } catch (_) {}
    }

    function reloadConfigIfChanged() {
        let m = 0;
        try { m = fs.statSync(config._file).mtimeMs; } catch (_) {}
        if (m !== configMtime) { configMtime = m; config = loadConfig(dir); log('server.config.json reloaded', 'INFO'); }
    }

    function backupRepo(reason, keep) {
        const src = path.join(dir, 'repo.json');
        if (!fs.existsSync(src)) return null;
        const bdir = path.join(privDir, 'backups');
        fs.mkdirSync(bdir, { recursive: true });
        const body = fs.readFileSync(src);
        const existing = fs.readdirSync(bdir).filter(n => /^repo-\d{8}-\d{6}.*\.json$/.test(n)).sort();
        const last = existing[existing.length - 1];
        if (reason === 'scheduled' && last && fs.readFileSync(path.join(bdir, last)).equals(body)) {
            return 'unchanged since ' + last + ', no new copy';
        }
        let name = 'repo-' + stamp(new Date()) + (reason === 'scheduled' ? '' : '-' + reason) + '.json';
        let n = 1;
        while (fs.existsSync(path.join(bdir, name))) name = name.replace(/(?:-\d+)?\.json$/, '-' + (++n) + '.json');
        fs.writeFileSync(path.join(bdir, name), body);
        const all = fs.readdirSync(bdir).filter(n => /^repo-\d{8}-\d{6}.*\.json$/.test(n)).sort();
        const limit = keep || 30;
        for (const old of all.slice(0, Math.max(0, all.length - limit))) { try { fs.unlinkSync(path.join(bdir, old)); } catch (_) {} }
        return 'saved ' + name;
    }

    const ctx = { dir, get config() { return config; }, backupRepo, log };

    function jobList() {
        return config.jobs.map((j, i) => {
            const id = String(j.id || (j.type + '-' + i));
            return Object.assign({}, j, { id, _schedule: parseSchedule(j) });
        });
    }

    async function runJob(job, why) {
        const fn = JOB_TYPES[job.type];
        if (!fn) { state[job.id] = Object.assign({}, state[job.id], { lastRun: Date.now(), result: 'error', message: 'unknown type "' + job.type + '"' }); saveState(); return state[job.id]; }
        if (running.has(job.id)) return { result: 'skipped', message: 'already running' };
        running.add(job.id);
        const t0 = Date.now();
        log(job.id + ' (' + job.type + ') started' + (why ? ' — ' + why : ''));
        let r;
        try { r = await fn(ctx, job); } catch (e) { r = { result: 'error', message: String(e && e.message || e) }; }
        running.delete(job.id);
        const prev = state[job.id] || {};
        const runs = (prev.runs || []).concat([{ at: t0, result: r.result, ms: Date.now() - t0 }]).slice(-10);
        state[job.id] = { lastRun: t0, durationMs: Date.now() - t0, result: r.result, message: r.message, runs };
        saveState();
        log(job.id + ' ' + r.result + ': ' + r.message, r.result === 'error' ? 'ERROR' : 'JOB');
        return state[job.id];
    }

    function tick() {
        reloadConfigIfChanged();
        if (config.jobsDisabled) return;
        const now = new Date();
        for (const job of jobList()) {
            if (job.enabled === false || !job._schedule || running.has(job.id)) continue;
            const st = state[job.id] || {};
            const due = nextRun(job._schedule, st.lastRun, startTime);
            if (due && due.getTime() <= now.getTime()) runJob(job, job._schedule.text);
        }
    }

    function startScheduler() {
        if (timer) return;
        for (const job of jobList()) {
            if (job.enabled === false) continue;
            if (!JOB_TYPES[job.type]) log('job ' + job.id + ': unknown type "' + job.type + '"', 'WARN');
            else if (!job._schedule && (job.every || job.cron)) log('job ' + job.id + ': unreadable schedule ' + JSON.stringify(job.every || job.cron), 'WARN');
            if (job.runOnStart && JOB_TYPES[job.type] && !config.jobsDisabled) runJob(job, 'on start');
        }
        timer = setInterval(tick, 15000);
        if (timer.unref) timer.unref();
    }

    function jobsView() {
        const now = new Date();
        return jobList().map(j => {
            const st = state[j.id] || {};
            const nr = j.enabled === false || config.jobsDisabled ? null : nextRun(j._schedule, st.lastRun, startTime);
            return {
                id: j.id, type: j.type, enabled: j.enabled !== false,
                schedule: j._schedule ? (j._schedule.kind === 'cron' ? 'cron ' + j._schedule.text : j._schedule.text) : (j.every || j.cron ? 'invalid: ' + (j.every || j.cron) : ''),
                lastRun: st.lastRun || null, durationMs: st.durationMs != null ? st.durationMs : null, result: st.result || null,
                message: st.message || '', nextRun: nr ? Math.max(nr.getTime(), now.getTime()) : null, running: running.has(j.id),
            };
        });
    }

    function readAccessPassword() {
        const a = readJson(path.join(dir, 'access.json'), {}) || {};
        return {
            password: typeof a.password === 'string' ? a.password : '',
            keys: Array.isArray(a.pubkeys) && a.pubkeys.some(k => typeof k === 'string' && k.trim()),
            audience: typeof a.audience === 'string' ? a.audience.trim() : '',
        };
    }

    function baseUrl(req) {
        const acc = readAccessPassword();
        const fixed = (config.publicUrl || acc.audience || '').trim();
        if (fixed) return fixed.replace(/\/+$/, '');
        const h = String((req.headers || {}).host || '');
        const host = h && !/[\/"<>\s\\]/.test(h) ? h : 'localhost' + (opts.port ? ':' + opts.port : '');
        const xfp = String((req.headers || {})['x-forwarded-proto'] || '').split(',')[0].trim().toLowerCase();
        const proto = xfp === 'https' || xfp === 'http' ? xfp : (req.socket && req.socket.encrypted ? 'https' : 'http');
        return proto + '://' + host;
    }

    function unlocked(req, url) {
        const acc = readAccessPassword();
        const pws = [acc.password, opts.downloadPassword || ''].filter(Boolean);
        if (!pws.length && !acc.keys) return true;
        if (acc.keys) return false;
        const given = (req.headers || {})['x-repo-password'] || url.searchParams.get('password') || url.searchParams.get('pw') || '';
        return pws.every(p => safeEqual(given, p));
    }

    let repoCache = { mtime: -1, repo: null, stats: null };
    function repoInfo() {
        const f = path.join(dir, 'repo.json');
        let st;
        try { st = fs.statSync(f); } catch (_) { return null; }
        if (st.mtimeMs !== repoCache.mtime) {
            const repo = readJson(f, null);
            repoCache = { mtime: st.mtimeMs, repo, stats: repo && typeof repo === 'object' ? manifestStats(repo) : null };
        }
        return repoCache.stats ? Object.assign({ updated: Math.floor(st.mtimeMs) }, repoCache.stats) : null;
    }

    function statusData(req, url) {
        const info = repoInfo();
        const base = baseUrl(req);
        const open = unlocked(req, url);
        const repo = info && open ? Object.assign({ protected: false }, info) : { protected: !open, name: 'BMM repo', format: info ? info.format : 'not a repo manifest', version: '', mods: 0, files: 0, size: 0, updated: null };
        return {
            healthy: !!info, kind, uptimeMs: Date.now() - startTime, base,
            connectLink: 'bmm://repo/connect?url=' + encodeURIComponent(base + '/'),
            repo, jobs: jobsView(), jobsDisabled: !!config.jobsDisabled,
        };
    }

    function rateLimited(ip) {
        const per = Number(config.rateLimit.perMinute) || 0;
        if (per <= 0 || !ip || ip === '127.0.0.1' || ip === '::1') return false;
        const burst = Math.max(1, Number(config.rateLimit.burst) || per);
        const now = Date.now();
        let b = buckets.get(ip);
        if (!b) { b = { tokens: burst, at: now }; buckets.set(ip, b); }
        b.tokens = Math.min(burst, b.tokens + ((now - b.at) / 60000) * per);
        b.at = now;
        if (buckets.size > 10000) for (const [k, v] of buckets) if (now - v.at > 600000) buckets.delete(k);
        if (b.tokens < 1) return Math.ceil((1 - b.tokens) * 60 / per);
        b.tokens -= 1;
        return false;
    }

    function json(res, code, obj) {
        res.statusCode = code;
        res.setHeader('Content-Type', 'application/json; charset=utf-8');
        res.setHeader('Cache-Control', 'no-store');
        res.end(JSON.stringify(obj));
    }

    function early(req, res, ip) {
        let url;
        try { url = new URL(req.url, 'http://x'); } catch (_) { return false; }
        const p = url.pathname.replace(/\/+$/, '') || '/';
        const wait = rateLimited(ip);
        if (wait) {
            res.statusCode = 429;
            res.setHeader('Retry-After', String(wait));
            res.end('Too many requests');
            return true;
        }
        if (p === '/health' || p === '/healthz') {
            const info = repoInfo();
            json(res, info ? 200 : 503, { ok: !!info, uptime: Math.round((Date.now() - startTime) / 1000), server: kind, extras: EXTRAS_VERSION });
            return true;
        }
        if ((p === '/status' || p === '/status.json') && config.statusPage !== false) {
            const s = statusData(req, url);
            if (p === '/status.json') { json(res, 200, s); return true; }
            res.statusCode = 200;
            res.setHeader('Content-Type', 'text/html; charset=utf-8');
            res.setHeader('Cache-Control', 'no-store');
            res.setHeader('Content-Security-Policy', "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:");
            res.end(renderStatus(s));
            return true;
        }
        if (p === '/admin/jobs' || p === '/admin/jobs/run') {
            const auth = (req.headers || {})['authorization'] || '';
            if (!opts.adminPassword || !safeEqual(String(auth).replace(/^Bearer\s+/i, ''), opts.adminPassword)) { json(res, 401, { err: 'Unauthorized' }); return true; }
            if (p === '/admin/jobs') { json(res, 200, { jobs: jobsView(), disabled: !!config.jobsDisabled }); return true; }
            if (String(req.method).toUpperCase() !== 'POST') { json(res, 405, { err: 'POST only' }); return true; }
            const id = url.searchParams.get('id') || '';
            const job = jobList().find(j => j.id === id);
            if (!job) { json(res, 404, { err: 'no job ' + id }); return true; }
            runJob(job, 'started by the admin').then(r => json(res, 200, r), e => json(res, 500, { err: String(e && e.message) }));
            return true;
        }
        return false;
    }

    function serve(req, res) {
        let url;
        try { url = new URL(req.url, 'http://x'); } catch (_) { return false; }
        const p = url.pathname.toLowerCase();
        if (p !== '/feed.xml' && p !== '/feed.atom') return false;
        const f = path.join(dir, 'repo.json');
        const repo = readJson(f, null);
        if (!repo || typeof repo !== 'object') { res.statusCode = 404; res.end('Not Found'); return true; }
        let updated = Date.now();
        try { updated = fs.statSync(f).mtimeMs; } catch (_) {}
        sendBody(req, res, atomFeed(repo, baseUrl(req), updated), 'application/atom+xml; charset=utf-8');
        return true;
    }

    function isPrivate(segs) {
        return Array.isArray(segs) && segs.length > 0 && String(segs[0]).toLowerCase() === PRIVATE_DIR;
    }

    function attach(server) {
        startScheduler();
        // Graceful stop for `docker stop` and systemd: finish what is being sent, then exit.
        // Only when nothing else listens, so the scripts' own handlers (tunnel, UPnP) stay in charge.
        setImmediate(() => {
            if (process.listenerCount('SIGTERM') > 0) return;
            process.once('SIGTERM', () => {
                log('SIGTERM: closing', 'INFO');
                if (timer) clearInterval(timer);
                try { server && server.close(() => process.exit(0)); } catch (_) { process.exit(0); }
                setTimeout(() => process.exit(0), 10000).unref();
            });
        });
    }

    return {
        get config() { return config; }, early, serve, prepareFile, sendBody, isPrivate, attach, safeEqual,
        runJob: (id) => { const j = jobList().find(x => x.id === id); return j ? runJob(j, 'manual') : Promise.resolve(null); },
        jobsView, statusData, stop: () => { if (timer) clearInterval(timer); timer = null; },
    };
}

module.exports = {
    create, EXTRAS_VERSION, PRIVATE_DIR,
    // exported for the self-test and for BMM's own tests
    parseEvery, parseCron, cronNext, parseSchedule, nextRun, parseRange, etagMatches, prepareFile, sendBody,
    atomFeed, repoFormatOf, manifestStats, manifestFiles, modFileTail, bumpVersion, renderStatus, loadConfig,
    jobRescan, jobSync, jobBackup, jobRotateLogs, insideDir, safeEqual,
};
