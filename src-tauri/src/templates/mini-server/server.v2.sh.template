/**
 * BMM_LW_V2 (Lightweight Linux Server)
 * Adapted for Debian/Ubuntu/Linux
 */

const http = require('http');
const https = require('https');
const fs = require('fs');
const path = require('path');
const zlib = require('zlib');
const { spawn, execSync } = require('child_process');

// Placeholders (populated by BMM during export)
const PORT = PORT_PLACEHOLDER;
const USE_CLOUDFLARE = USE_CLOUDFLARE_PLACEHOLDER;
const USE_UPNP = USE_UPNP_PLACE_HOLDER; 
const CLOUDFLARE_PATH = 'CLOUDFLARE_BINARY_PLACEHOLDER';
const UPLOAD_LIMIT = UPLOAD_LIMIT_PLACEHOLDER; // KB/s
const ADMIN_PASSWORD = 'ADMIN_PASSWORD_PLACEHOLDER';

const VERSION = "2.4.0-linux";
const logFile = path.join(__dirname, 'server.log');
const bansFile = path.join(__dirname, 'bans.json');
const whitelistFile = path.join(__dirname, 'whitelist.json');
const repoFile = path.join(__dirname, 'repo.json');
const historyFile = path.join(__dirname, 'history.json');
const downloadsFile = path.join(__dirname, 'downloads.json');

const stats = { uptime: Date.now(), totalDownloads: 0, totalBytesSent: 0, mods: {} };
if (fs.existsSync(downloadsFile)) {
    try { 
        const saved = JSON.parse(fs.readFileSync(downloadsFile, 'utf8')); 
        stats.totalDownloads = saved.totalDownloads || 0;
        stats.totalBytesSent = saved.totalBytesSent || 0;
        stats.mods = saved.mods || {};
    } catch(e) {}
}

const sessions = new Map(); 
const history = [];

let repoData = { modpacks: [] };
let totalRepoSize = 0;

function updateRepoCache() {
    if (fs.existsSync(repoFile)) {
        try { 
            repoData = JSON.parse(fs.readFileSync(repoFile, 'utf8')); 
            totalRepoSize = 0;
            if (repoData.profiles) {
                repoData.profiles.forEach(p => {
                    if (p.mods) p.mods.forEach(m => {
                        if (m.files) m.files.forEach(f => totalRepoSize += (f.size || 0));
                    });
                });
            }
        } catch(e) {}
    }
}
updateRepoCache();

function getLocalIP() {
    const interfaces = require('os').networkInterfaces();
    for (const name of Object.keys(interfaces)) {
        if (name.toLowerCase().includes('virtual') || name.toLowerCase().includes('vbox') || name.toLowerCase().includes('vmware') || name.toLowerCase().includes('docker')) continue;
        for (const iface of interfaces[name]) {
            if (iface.family === 'IPv4' && !iface.internal) return iface.address;
        }
    }
    return '127.0.0.1';
}

const LOCAL_IP = getLocalIP();

function log(msg, level = 'INFO', print = true) {
    const ts = new Date().toISOString().replace('T', ' ').split('.')[0];
    const line = "[" + ts + "][" + level + "] " + msg;
    if (print) {
        const colors = { INFO: '\x1b[36m', ERROR: '\x1b[31m', WARN: '\x1b[33m', BAN: '\x1b[35m', OK: '\x1b[32m', ADMIN: '\x1b[35m' };
        console.log((colors[level] || '') + line + '\x1b[0m');
    }
    try { fs.appendFileSync(logFile, line + '\n', 'utf8'); } catch(e) {}
}

function addToHistory(ip, creatorId, event, details = "") {
    const item = { ts: Date.now(), ip, creatorId, event, details };
    history.unshift(item);
    if (history.length > 500) history.pop();
    try { fs.writeFileSync(historyFile, JSON.stringify(history.slice(0, 100))); } catch(e) {}
}

if (fs.existsSync(historyFile)) {
    try { const saved = JSON.parse(fs.readFileSync(historyFile, 'utf8')); history.push(...saved); } catch(e) {}
}

const activeDownloads = new Map();

function getMonitoringReport() {
    const activeSessions = [];
    const now = Date.now();
    sessions.forEach((s, ip) => {
        if (now - s.lastSeen < 60000) activeSessions.push({ ip, ...s });
    });

    return {
        server: { version: VERSION, uptime: Date.now() - stats.uptime, totalBytes: stats.totalBytesSent, totalDls: stats.totalDownloads, totalRepoSize, modsDownloads: stats.mods },
        active: Array.from(activeDownloads.values()).map(dl => ({
            ...dl,
            speed: dl.downloaded / ((Math.max(1, Date.now() - dl.startTime))/1000)
        })),
        sessions: activeSessions,
        history: history.slice(0, 50)
    };
}

function getSecurityData() {
    let bans = { banned_ips: [], banned_keys: [] };
    let wl = { enabled: false, ips: [], keys: [] };
    let repo = { modpacks: [] };
    if (fs.existsSync(bansFile)) try { bans = JSON.parse(fs.readFileSync(bansFile, 'utf8')); } catch(e) {}
    if (fs.existsSync(whitelistFile)) try { wl = JSON.parse(fs.readFileSync(whitelistFile, 'utf8')); } catch(e) {}
    if (fs.existsSync(repoFile)) try { repo = JSON.parse(fs.readFileSync(repoFile, 'utf8')); } catch(e) {}
    return { bans, whitelist: wl, repo };
}

