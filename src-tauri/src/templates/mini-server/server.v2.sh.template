    <script>
        let adminPass = "";
        let currentData = null;
        let lastFullData = null;


        async function api(path, method = 'GET', body = null) {
            const opts = { method, headers: { 'Authorization': adminPass } };
            if (body) { opts.body = JSON.stringify(body); opts.headers['Content-Type'] = 'application/json'; }
            return fetch(path, opts).then(r => r.status === 401 ? null : r.json());
        }

        function showTab(id, e) {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.sidebar-item').forEach(i => i.classList.remove('active'));
            document.getElementById('tab-' + id).classList.add('active');
            if (e) e.target.classList.add('active');
        }

        async function refreshData() {
            const data = await api('/admin/data');
            if (!data) return false;
            currentData = data;
            renderSecurity();
            return true;
        }

        function renderSecurity() {
            const { whitelist, bans, repo } = currentData;
            document.getElementById('wl-enabled').checked = whitelist.enabled;
            
            document.getElementById('wl-list').innerHTML = [...whitelist.ips, ...whitelist.keys].map(v => {
                let row = '<div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid var(--border)">';
                row += '<span>' + v + '</span><button class="btn btn-sm btn-danger" onclick="removeItem(&quot;wl&quot;, &quot;' + v + '&quot;)">DEL</button>';
                row += '</div>';
                return row;
            }).join('');

            document.getElementById('ban-list').innerHTML = [...bans.banned_ips, ...bans.banned_keys].map(v => {
                let row = '<div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid var(--border)">';
                row += '<span>' + v + '</span><button class="btn btn-sm btn-danger" onclick="removeItem(&quot;ban&quot;, &quot;' + v + '&quot;)">UNBAN</button>';
                row += '</div>';
                return row;
            }).join('');
            
            const modpacks = repo && Array.isArray(repo.modpacks) ? repo.modpacks : [];
            document.getElementById('modpacks-list').innerHTML = modpacks.map((m, i) => {
                const mp = m.modpack || m;
                let row = '<div style="background:rgba(255,255,255,0.02); padding:12px; border-radius:10px; border:1px solid var(--border); display:flex; justify-content:space-between; align-items:center;">';
                row += '<div><div style="font-weight:700; font-size:12px;">' + (mp.name || 'Unnamed') + '</div>';
                row += '<div style="font-size:9px; color:var(--muted)">MODS: ' + (mp.mods ? mp.mods.length : 0) + ' | MODE: ' + (m.share_mode || 'public') + '</div></div>';
                row += '<label class="toggle"><input type="checkbox" ' + (m.enabled !== false ? 'checked' : '') + ' onchange="toggleModpack(' + i + ')"><span class="slider"></span></label>';
                row += '</div>';
                return row;
            }).join('');
        }

        async function addToSecurity(type, val = null) {
            const input = document.getElementById(type + '-input');
            const target = val || input.value.trim();
            if (!target) return;
            if (type === 'wl') { if (target.includes('.')) currentData.whitelist.ips.push(target); else currentData.whitelist.keys.push(target); }
            else { if (target.includes('.')) currentData.bans.banned_ips.push(target); else currentData.bans.banned_keys.push(target); }
            if (input) input.value = '';
            await saveChanges();
        }

        async function removeItem(type, val) {
            if (type === 'wl') {
                currentData.whitelist.ips = currentData.whitelist.ips.filter(v => v !== val);
                currentData.whitelist.keys = currentData.whitelist.keys.filter(v => v !== val);
            } else {
                currentData.bans.banned_ips = currentData.bans.banned_ips.filter(v => v !== val);
                currentData.bans.banned_keys = currentData.bans.banned_keys.filter(v => v !== val);
            }
            await saveChanges();
        }

        async function toggleModpack(idx) {
            const m = currentData.repo.modpacks[idx];
            m.enabled = m.enabled === undefined ? false : !m.enabled;
            await saveChanges();
        }

        async function saveChanges() {
            currentData.whitelist.enabled = document.getElementById('wl-enabled').checked;
            await api('/admin/update', 'POST', currentData);
            renderSecurity();
        }

        function formatBytes(b) {
            if (b < 1024) return b + ' B';
            if (b < 1048576) return (b / 1024).toFixed(1) + ' KB';
            return (b / 1048576).toFixed(1) + ' MB';
        }

        function formatUptime(ms) {
            const s = Math.floor(ms / 1000);
            const d = Math.floor(s / 86400);
            const h = Math.floor((s % 86400) / 3600);
            const m = Math.floor((s % 3600) / 60);
            const sec = s % 60;
            let str = '';
            if (d > 0) str += d + 'd ';
            if (h > 0) str += h + 'h ';
            if (m > 0) str += m + 'm ';
            if (sec > 0 || str === '') str += sec + 's';
            return str;
        }

        async function updateStats() {
            const data = await fetch('/monitoring.json').then(r => r.json());
            lastFullData = data;
            document.getElementById('stat-uptime').innerText = formatUptime(data.server.uptime);
            document.getElementById('stat-data').innerText = formatBytes(data.server.totalBytes);
            document.getElementById('stat-active').innerText = data.sessions.length;

            const sQuery = document.getElementById('session-search').value.toLowerCase();
            const hQuery = document.getElementById('history-search').value.toLowerCase();
            const hUserFilter = document.getElementById('history-user-filter').value;

            // Update User Filter Dropdown
            const filterSelect = document.getElementById('history-user-filter');
            const currentUsers = new Set();
            data.history.forEach(h => { if(h.ip) currentUsers.add(h.ip); if(h.creatorId && h.creatorId !== "UNKNOWN") currentUsers.add(h.creatorId); });
            
            // Only rebuild if count changed to avoid losing selection
            if (filterSelect.options.length !== currentUsers.size + 1) {
                const currentVal = filterSelect.value;
                filterSelect.innerHTML = '<option value="ALL">All Users</option>';
                Array.from(currentUsers).sort().forEach(u => {
                    const opt = document.createElement('option');
                    opt.value = u; opt.textContent = u;
                    filterSelect.appendChild(opt);
                });
                filterSelect.value = currentVal;
            }

            const filteredSessions = data.sessions.filter(s => s.ip.toLowerCase().includes(sQuery) || s.creatorId.toLowerCase().includes(sQuery));
            
            const filteredHistory = data.history.filter(h => {
                const matchQuery = h.ip.toLowerCase().includes(hQuery) || h.creatorId.toLowerCase().includes(hQuery) || h.event.toLowerCase().includes(hQuery) || h.details.toLowerCase().includes(hQuery);
                const matchUser = hUserFilter === 'ALL' || h.ip === hUserFilter || h.creatorId === hUserFilter;
                return matchQuery && matchUser;
            });

            const stab = document.getElementById('session-table');
            stab.innerHTML = filteredSessions.map(s => {
                const activeDl = data.active.find(dl => dl.ip === s.ip);
                const progress = data.server.totalRepoSize > 0 ? (s.bytes / data.server.totalRepoSize * 100) : 0;
                let row = '<tr>';
                row += '<td><div style="font-weight:700">' + s.ip + '</div><div style="font-size:9px; color:var(--muted)">ID: ' + s.creatorId + '</div></td>';
                row += '<td>' + (activeDl ? 'DL: ' + activeDl.file : 'IDLE') + '</td>';
                row += '<td><div style="font-weight:700">' + formatBytes(s.bytes) + ' (' + progress.toFixed(1) + '% of Repo)</div>';
                row += '<div class="progress-bg"><div class="progress-fill" style="width:' + Math.min(100, progress) + '%"></div></div></td>';
                row += '<td style="color:var(--success); font-weight:800">' + (activeDl ? formatBytes(activeDl.speed) + '/s' : '-') + '</td>';
                row += '<td><div style="display:flex; gap:6px;">';
                row += '<button class="btn btn-sm" onclick="inspectSession(&quot;' + s.ip + '&quot;)">INSPECT</button>';
                row += '<button class="btn btn-sm btn-danger" onclick="addToSecurity(&quot;ban&quot;, &quot;' + s.ip + '&quot;)">BAN</button>';
                row += '</div></td></tr>';
                return row;
            }).join('');

            document.getElementById('history-table').innerHTML = filteredHistory.map(h => {
                let row = '<tr>';
                row += '<td style="color:var(--muted); font-size:11px;">' + new Date(h.ts).toLocaleTimeString() + '</td>';
                row += '<td><div style="font-weight:700">' + h.ip + '</div><div style="font-size:9px; color:var(--muted)">ID: ' + h.creatorId + '</div></td>';
                row += '<td><span class="badge ' + (h.event === 'REJECTED' ? 'badge-danger' : 'badge-info') + '">' + h.event + '</span></td>';
                row += '<td style="font-size:11px; max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">' + h.details + '</td>';
                row += '<td><button class="btn btn-sm btn-danger" onclick="addToSecurity(&quot;ban&quot;, &quot;' + h.ip + '&quot;)">BAN</button></td>';
                row += '</tr>';
                return row;
            }).join('');
        }

        function inspectSession(ip) {
            const s = lastFullData.sessions.find(x => x.ip === ip);
            if (!s) return;
            document.getElementById('inspect-title').innerText = 'Session Inspector: ' + ip;
            const filesHtml = s.files.length ? s.files.map(f => '<div style="font-size:11px; margin-bottom:5px; word-break: break-all;">[OK] ' + f + '</div>').join('') : 'No files recorded yet.';
            
            let body = '<div style="margin-bottom:20px;">';
            body += '<div style="font-size:12px; color:var(--muted); margin-bottom:5px;">CLIENT CREATOR ID</div>';
            body += '<div style="font-weight:800; word-break: break-all;">' + s.creatorId + '</div></div>';
            body += '<div style="margin-bottom:20px;">';
            body += '<div style="font-size:12px; color:var(--muted); margin-bottom:5px;">SESSION DOWNLOADED DATA</div>';
            body += '<div style="font-weight:800; color:var(--accent)">' + formatBytes(s.bytes) + '</div></div>';
            body += '<div><div style="font-size:12px; color:var(--muted); margin-bottom:10px;">DOWNLOAD HISTORY</div>';
            body += '<div style="max-height:200px; overflow-y:auto; overflow-x:hidden; background:rgba(0,0,0,0.2); padding:10px; border-radius:8px; border:1px solid var(--border);">';
            body += filesHtml + '</div></div>';
            
            document.getElementById('inspect-body').innerHTML = body;
            document.getElementById('inspector-modal').style.display = 'flex';
        }

        function closeModal() { document.getElementById('inspector-modal').style.display = 'none'; }

        async function fetchLogs() {
            const logs = await api('/admin/logs');
            if (logs) {
                const box = document.getElementById('log-box');
                const scroll = box.scrollHeight - box.scrollTop <= box.clientHeight + 50;
                box.innerHTML = logs.lines.map(l => '<div style="margin-bottom:2px">' + l + '</div>').join('');
                if (scroll) box.scrollTop = box.scrollHeight;
            }
        }

        async function login() {
            const pw = document.getElementById('admin-pass').value;
            adminPass = pw;
            const ok = await refreshData();
            if (ok) {
                localStorage.setItem('bmm_token', pw);
                document.getElementById('auth-overlay').style.display = 'none';
                updateStats();
                setInterval(updateStats, 2000);
                setInterval(fetchLogs, 2000);
            } else {
                alert('Invalid Password');
            }
        }

        const savedToken = localStorage.getItem('bmm_token');
        if (savedToken) {
            document.getElementById('admin-pass').value = savedToken;
            login();
        }
    </script>
</body>
</html>
`;

// ────────────────────────────────────────────────────────────
//  SERVER CORE
// ────────────────────────────────────────────────────────────
const server = http.createServer((req, res) => {
    res.setHeader('Access-Control-Allow-Origin', '*');
    res.setHeader('Access-Control-Allow-Methods', 'GET, OPTIONS');
    res.setHeader('Access-Control-Allow-Headers', 'Origin, X-Requested-With, Content-Type, Accept, Range, x-creator-key, x-creator-id, Authorization');
    if (req.method === 'OPTIONS') {
        res.statusCode = 204;
        res.end();
        return;
    }

    const xff = req.headers['x-forwarded-for'];
    const ip = (xff ? xff.split(',')[0].trim() : req.socket.remoteAddress || '127.0.0.1').replace('::ffff:', '');
    const isAuthorized = () => req.headers['authorization'] === ADMIN_PASSWORD;

    const urlObj = new URL(req.url, "http://" + (req.headers.host || "localhost"));
    const queryKey = urlObj.searchParams.get('key') || urlObj.searchParams.get('id') || urlObj.searchParams.get('creatorid');
    const headerKey = req.headers['x-creator-id'] || req.headers['x-creator-key'] || req.headers['x-bmm-id'] || req.headers['authorization'];
    const key = (headerKey || queryKey || "UNKNOWN").replace('Bearer ', '').trim();

    if (!sessions.has(ip)) {
        sessions.set(ip, { creatorId: key, bytes: 0, lastSeen: Date.now(), files: [] });
        if (key !== "UNKNOWN") addToHistory(ip, key, "CONNECTION", "Session started with ID");
        else addToHistory(ip, "UNKNOWN", "CONNECTION", "Anonymous session started");
    } else {
        const s = sessions.get(ip);
        s.lastSeen = Date.now();
        if (key !== "UNKNOWN" && (s.creatorId === "UNKNOWN" || s.creatorId === "")) {
            s.creatorId = key;
            addToHistory(ip, key, "IDENTITY", "Creator ID identified");
        }
    }

    if (req.url === '/dashboard') { res.setHeader('Content-Type', 'text/html'); res.end(DASHBOARD_HTML); return; }
    if (req.url === '/monitoring.json') { res.setHeader('Content-Type', 'application/json'); res.end(JSON.stringify(getMonitoringReport())); return; }

    if (req.url === '/admin/data') {
        if (!isAuthorized()) { res.statusCode = 401; res.end(JSON.stringify({err: "Unauthorized"})); return; }
        res.setHeader('Content-Type', 'application/json');
        res.end(JSON.stringify(getSecurityData()));
        return;
    }

    if (req.url === '/admin/logs') {
        if (!isAuthorized()) { res.statusCode = 401; res.end(JSON.stringify({err: "Unauthorized"})); return; }
        res.setHeader('Content-Type', 'application/json');
        try { const logs = fs.readFileSync(logFile, 'utf8').split('\n').filter(l => l.trim()).slice(-100); res.end(JSON.stringify({lines: logs})); } catch(e) { res.end(JSON.stringify({lines: []})); }
        return;
    }

    if (req.url === '/admin/update' && req.method === 'POST') {
        if (!isAuthorized()) { res.statusCode = 401; res.end(JSON.stringify({err: "Unauthorized"})); return; }
        let body = ''; req.on('data', c => body += c);
        req.on('end', () => {
            try {
                const data = JSON.parse(body);
                fs.writeFileSync(bansFile, JSON.stringify(data.bans, null, 2));
                fs.writeFileSync(whitelistFile, JSON.stringify(data.whitelist, null, 2));
                fs.writeFileSync(repoFile, JSON.stringify(data.repo, null, 2));
                updateRepoCache();
                log("Server config updated", 'ADMIN');
                res.end(JSON.stringify({ok: true}));
            } catch(e) { res.statusCode = 400; res.end(JSON.stringify({err: e.message})); }
        });
        return;
    }

    const { bans, whitelist } = getSecurityData();
    const isLocal = ip === '127.0.0.1' || ip === '::1';
    if (!isLocal) {
        if (bans.banned_ips.includes(ip) || (key !== "UNKNOWN" && bans.banned_keys.includes(key))) { 
            res.statusCode = 403; res.end('Banned'); 
            addToHistory(ip, key, "REJECTED", "Banned identity");
            return; 
        }
        if (whitelist.enabled && !whitelist.ips.includes(ip) && !(key !== "UNKNOWN" && whitelist.keys.includes(key))) { 
            res.statusCode = 403; res.end('Not Whitelisted'); 
            addToHistory(ip, key, "REJECTED", "Access denied (whitelist)");
            return; 
        }
    }

    let urlPath = decodeURIComponent(req.url.split('?')[0]);
    if (urlPath === '/' || urlPath === '') urlPath = '/repo.json';
    
    // Fix for Linux: remove leading slash before joining to avoid absolute path reset
    const relativeUrl = urlPath.startsWith('/') ? urlPath.substring(1) : urlPath;
    const absolutePath = path.resolve(__dirname, relativeUrl);

    if (!absolutePath.startsWith(__dirname) || !fs.existsSync(absolutePath) || !fs.statSync(absolutePath).isFile()) {
        res.statusCode = 404; res.end('Not Found'); return;
    }

    if (urlPath === '/repo.json') {
        try {
            const repo = JSON.parse(fs.readFileSync(absolutePath, 'utf8'));
            if (repo && Array.isArray(repo.modpacks)) repo.modpacks = repo.modpacks.filter(m => m && m.enabled !== false);
            const content = JSON.stringify(repo);
            res.setHeader('Content-Type', 'application/json');
            if (req.headers['accept-encoding'] && req.headers['accept-encoding'].includes('gzip')) {
                res.setHeader('Content-Encoding', 'gzip');
                zlib.gzip(content, (err, buffer) => res.end(buffer));
            } else res.end(content);
        } catch(e) { res.statusCode = 500; res.end(JSON.stringify({err: "Failed to parse repo.json"})); }
        return;
    }

    const total = fs.statSync(absolutePath).size;
    const protocol = isLocal ? 'Local' : (ip.startsWith('192.168.') ? 'LAN' : 'WAN');
    const dlId = ip + "-" + Date.now();
    const dlObj = { ip, creatorId: key, file: urlPath, total, downloaded: 0, startTime: Date.now(), protocol };
    
    activeDownloads.set(dlId, dlObj);
    stats.totalDownloads++;
    addToHistory(ip, key, "DL_START", urlPath);
    const s = sessions.get(ip); if (s && !s.files.includes(urlPath)) s.files.push(urlPath);

    res.statusCode = 200;
    const mime = { '.json': 'application/json', '.zip': 'application/zip', '.lua': 'text/plain' };
    res.setHeader('Content-Type', mime[path.extname(absolutePath).toLowerCase()] || 'application/octet-stream');
    res.setHeader('Content-Length', total);

    const stream = fs.createReadStream(absolutePath);
    let bytesSentInInterval = 0; let intervalStart = Date.now();

    stream.on('data', chunk => {
        dlObj.downloaded += chunk.length;
        stats.totalBytesSent += chunk.length;
        const ses = sessions.get(ip); if (ses) ses.bytes += chunk.length;

        if (UPLOAD_LIMIT > 0) {
            bytesSentInInterval += chunk.length;
            const now = Date.now(); const elapsed = now - intervalStart;
            if (elapsed < 1000 && bytesSentInInterval > (UPLOAD_LIMIT * 1024)) {
                stream.pause();
                setTimeout(() => { bytesSentInInterval = 0; intervalStart = Date.now(); stream.resume(); }, 1000 - elapsed);
            } else if (elapsed >= 1000) { bytesSentInInterval = 0; intervalStart = now; }
        }
    });

    // Periodically save stats
    let saveTimeout = null;
    const saveStats = () => {
        if (saveTimeout) clearTimeout(saveTimeout);
        saveTimeout = setTimeout(() => {
            try { fs.writeFileSync(downloadsFile, JSON.stringify({ totalDownloads: stats.totalDownloads, totalBytesSent: stats.totalBytesSent, mods: stats.mods })); } catch(e) {}
        }, 5000);
    };

    stream.on('end', () => { 
        activeDownloads.delete(dlId);
        addToHistory(ip, key, "DL_FINISH", urlPath);
        // Track per-mod downloads if it's a mod file
        if (urlPath.includes('/mods/')) {
            const parts = urlPath.split('/mods/')[1].split('/');
            if (parts.length > 0) {
                const modId = parts[0];
                stats.mods[modId] = (stats.mods[modId] || 0) + 1;
                saveStats();
            }
        } else {
            saveStats();
        }
    });
    res.on('close', () => { stream.destroy(); activeDownloads.delete(dlId); });
    stream.pipe(res);
});

server.on('error', (e) => {
    if (e.code === 'EADDRINUSE') {
        console.log("\n[ERROR] Port " + PORT + " already in use!");
        setTimeout(() => process.exit(1), 5000);
    }
});

async function ensureCloudflared(cfPath) {
    if (fs.existsSync(cfPath) && fs.statSync(cfPath).size > 10 * 1024 * 1024) return true;
    const arch = (process.arch === 'x64') ? 'amd64' : (process.arch === 'arm64' ? 'arm64' : 'arm');
    const url = "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-" + arch;
    log("Downloading cloudflared for Linux (" + arch + ")...", 'INFO');
    try {
        execSync("curl -L " + url + " -o " + cfPath + " && chmod +x " + cfPath, { stdio: 'ignore' });
        return fs.existsSync(cfPath);
    } catch (e) { 
        try {
            execSync("wget -O " + cfPath + " " + url + " && chmod +x " + cfPath, { stdio: 'ignore' });
            return fs.existsSync(cfPath);
        } catch(e2) { return false; }
    }
}

async function ensureUpnpc() {
    try {
        execSync('upnpc -h', { stdio: 'ignore' });
        return true;
    } catch (e) {
        log('UPnP: upnpc not found, attempting auto-install...', 'INFO');
        try {
            // Try Alpine (apk)
            execSync('apk add miniupnpc', { stdio: 'ignore' });
            return true;
        } catch (e2) {
            try {
                // Try Debian/Ubuntu (apt)
                execSync('sudo apt update && sudo apt install -y miniupnpc', { stdio: 'ignore' });
                return true;
            } catch (e3) {
                return false;
            }
        }
    }
}

server.listen(PORT, '0.0.0.0', async () => {
    console.clear();
    const cyan = '\x1b[36m'; const green = '\x1b[32m'; const magenta = '\x1b[35m';
    const blue = '\x1b[34m'; const reset = '\x1b[0m'; const bold = '\x1b[1m';
    const underline = '\x1b[4m';

    console.log(bold + cyan + "   +------------------------------------------------------+" + reset);
    console.log("   |             BMM_LW_V2 LINUX SERVER v" + VERSION + "            |");
    console.log("   +------------------------------------------------------+" + reset + "\n");
    console.log("  " + bold + green + "[STATUS]" + reset + "  SERVER ONLINE");
    console.log("  " + bold + cyan + "[LAN]" + reset + "     http://" + LOCAL_IP + ":" + PORT + "/");
    console.log("  " + bold + magenta + "[ADMIN]" + reset + "   Password: " + underline + ADMIN_PASSWORD + reset);
    console.log("  " + bold + blue + "[DASH]" + reset + "    http://" + LOCAL_IP + ":" + PORT + "/dashboard\n");

    if (USE_UPNP) {
        if (await ensureUpnpc()) {
            try {
                log('UPnP: Attempting port mapping...', 'INFO');
                execSync('upnpc -a ' + LOCAL_IP + ' ' + PORT + ' ' + PORT + ' TCP', { stdio: 'ignore' });
                log('UPnP: Port ' + PORT + ' mapped successfully', 'OK');
            } catch (e) {
                log('UPnP: Failed to map port (router may not support it)', 'WARN');
            }
        } else {
            log('UPnP: upnpc not found and auto-install failed', 'WARN');
        }
    }

    if (USE_CLOUDFLARE) {
        const cfExe = CLOUDFLARE_PATH === 'AUTO' ? path.join(__dirname, 'cloudflared') : CLOUDFLARE_PATH;
        if (await ensureCloudflared(cfExe)) {
            if (fs.existsSync('cf.log')) { try { fs.unlinkSync('cf.log'); } catch(e) {} }
            const cf = spawn(cfExe, ['tunnel', '--no-autoupdate', '--url', "http://127.0.0.1:" + PORT, '--logfile', 'cf.log'], { detached: true, stdio: 'ignore' });
            cf.unref();
            log('Tunnel: Starting...', 'INFO');
            const checkLog = setInterval(() => {
                if (fs.existsSync('cf.log')) {
                    const content = fs.readFileSync('cf.log', 'utf8');
                    const match = content.match(/https:\/\/[a-z0-9-]+\.trycloudflare\.com/);
                    if (match) {
                        console.log("  " + bold + magenta + "[PUBLIC]" + reset + "  " + match[0]);
                        log("Public URL: " + match[0], 'OK', false);
                        clearInterval(checkLog);
                    }
                }
            }, 1000);
            setTimeout(() => clearInterval(checkLog), 30000);
        } else {
            log('Tunnel: Failed to download cloudflared binary', 'ERROR');
        }
    }
});
