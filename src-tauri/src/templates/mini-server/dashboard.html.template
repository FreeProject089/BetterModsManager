<!DOCTYPE html>
<html>
<head>
    <title>BMM Dedicated Server Admin Console</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        :root { --bg: #04060b; --card: #0f172a; --accent: #3b82f6; --text: #f8fafc; --muted: #94a3b8; --border: rgba(255,255,255,0.08); --success: #10b981; --danger: #ef4444; }
        * { box-sizing: border-box; }
        body { font-family: 'Inter', system-ui, sans-serif; background: var(--bg); color: var(--text); margin: 0; display: flex; height: 100vh; overflow: hidden; }
        .sidebar { width: 240px; background: #080b14; border-right: 1px solid var(--border); display: flex; flex-direction: column; padding: 25px 0; }
        .sidebar-item { padding: 14px 25px; cursor: pointer; color: var(--muted); font-size: 13px; font-weight: 700; transition: 0.2s; display: flex; align-items: center; gap: 12px; border-left: 3px solid transparent; }
        .sidebar-item:hover { color: var(--text); background: rgba(255,255,255,0.02); }
        .sidebar-item.active { color: var(--accent); background: rgba(59, 130, 246, 0.08); border-left: 3px solid var(--accent); }
        .main { flex: 1; padding: 35px; overflow-y: auto; }
        .card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 22px; margin-bottom: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.3); }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 18px; margin-bottom: 25px; }
        .stat-val { font-size: 28px; font-weight: 900; margin: 5px 0; color: #fff; }
        .stat-label { font-size: 10px; font-weight: 800; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; }
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; padding: 12px; color: var(--muted); font-size: 10px; text-transform: uppercase; border-bottom: 1px solid var(--border); }
        td { padding: 12px; border-bottom: 1px solid var(--border); font-size: 13px; }
        .btn { padding: 8px 14px; border-radius: 6px; border: 1px solid var(--border); background: rgba(255,255,255,0.05); color: var(--text); cursor: pointer; font-size: 11px; font-weight: 700; transition: 0.2s; }
        .btn:hover { background: rgba(255,255,255,0.1); }
        .btn-primary { background: var(--accent); color: #fff; border: none; }
        .btn-danger { color: var(--danger); border-color: rgba(239, 68, 68, 0.2); }
        .input { background: rgba(0,0,0,0.3); border: 1px solid var(--border); border-radius: 6px; padding: 8px 12px; color: #fff; width: 100%; outline: none; font-size: 13px; }
        .input:focus { border-color: var(--accent); }
        .progress-bg { width: 100%; height: 5px; background: rgba(255,255,255,0.05); border-radius: 2px; overflow: hidden; margin-top: 5px; }
        .progress-fill { height: 100%; background: var(--accent); transition: width 0.3s; }
        .badge { padding: 3px 6px; border-radius: 4px; font-size: 9px; font-weight: 800; text-transform: uppercase; }
        .badge-info { background: rgba(59, 130, 246, 0.1); color: #60a5fa; }
        .badge-success { background: rgba(16, 185, 129, 0.1); color: #34d399; }
        .toggle { position: relative; display: inline-block; width: 34px; height: 18px; }
        .toggle input { opacity: 0; width: 0; height: 0; }
        .slider { position: absolute; cursor: pointer; inset: 0; background: #334155; border-radius: 18px; transition: 0.3s; }
        .slider:before { position: absolute; content: ""; height: 12px; width: 12px; left: 3px; bottom: 3px; background: #fff; border-radius: 50%; transition: 0.3s; }
        input:checked + .slider { background: var(--success); }
        input:checked + .slider:before { transform: translateX(16px); }
        #auth-overlay { position: fixed; inset: 0; background: var(--bg); display: flex; align-items: center; justify-content: center; z-index: 2000; }
        .log-box { background: #000; color: #cbd5e1; font-family: 'JetBrains Mono', monospace; font-size: 11px; height: 550px; overflow-y: auto; padding: 15px; border-radius: 8px; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .search-box { margin-bottom: 15px; display: flex; gap: 10px; }
        .modal { position: fixed; inset: 0; background: rgba(0,0,0,0.8); display: none; align-items: center; justify-content: center; z-index: 3000; padding: 20px; }
        .modal-content { background: var(--card); border: 1px solid var(--border); border-radius: 12px; width: 100%; max-width: 600px; max-height: 80vh; overflow-y: auto; padding: 25px; }
    </style>
</head>
<body>
    <div id="auth-overlay">
        <div class="card" style="width: 320px; text-align: center;">
            <h2 style="margin:0 0 10px 0; font-size: 18px;">BMM Dedicated Server</h2>
            <p style="color:var(--muted); font-size:12px; margin-bottom:20px;">Admin Authentication</p>
            <input type="password" id="admin-pass" class="input" style="text-align:center; margin-bottom:15px;" placeholder="Password">
            <button class="btn btn-primary" style="width:100%" onclick="login()">Enter</button>
        </div>
    </div>

    <div id="inspector-modal" class="modal">
        <div class="modal-content">
            <div style="display:flex; justify-content:space-between; margin-bottom:20px;">
                <h3 id="inspect-title" style="margin:0">Session Details</h3>
                <button class="btn btn-sm" onclick="closeModal()">Close</button>
            </div>
            <div id="inspect-body"></div>
        </div>
    </div>

    <div class="sidebar">
        <div style="padding: 0 25px 25px; border-bottom: 1px solid var(--border); margin-bottom: 15px;">
            <div style="font-weight: 900; font-size: 16px; letter-spacing: 0.5px;">BMM SERVER</div>
            <div style="font-size: 9px; color: var(--success); font-weight: 800; margin-top: 4px;">[ONLINE]</div>
        </div>
        <div class="sidebar-item active" onclick="showTab('status', event)">MONITORING</div>
        <div class="sidebar-item" onclick="showTab('history', event)">HISTORY</div>
        <div class="sidebar-item" onclick="showTab('security', event)">SECURITY</div>
        <div class="sidebar-item" onclick="showTab('modpacks', event)">MODPACKS</div>
        <div class="sidebar-item" onclick="showTab('logs', event)">LOGS</div>
    </div>

    <div class="main">
        <!-- Status Tab -->
        <div id="tab-status" class="tab-content active">
            <div class="grid">
                <div class="card"><div class="stat-label">Uptime</div><div class="stat-val" id="stat-uptime">0s</div></div>
                <div class="card"><div class="stat-label">Sent Data</div><div class="stat-val" id="stat-data">0 MB</div></div>
                <div class="card"><div class="stat-label">Active Users</div><div class="stat-val" id="stat-active">0</div></div>
            </div>
            <div class="card" style="padding:0; overflow:hidden;">
                <div style="padding: 15px 20px; border-bottom: 1px solid var(--border); display:flex; justify-content:space-between; align-items:center;">
                    <span style="font-weight: 800; font-size: 13px;">ACTIVE SESSIONS</span>
                    <input type="text" id="session-search" class="input" placeholder="Search by IP or ID..." style="width:200px; height:30px; font-size:11px;">
                </div>
                <table>
                    <thead><tr><th>Client</th><th>Activity</th><th>Total Data / Progress</th><th>Speed</th><th>Actions</th></tr></thead>
                    <tbody id="session-table"></tbody>
                </table>
            </div>
        </div>

        <!-- History Tab -->
        <div id="tab-history" class="tab-content">
            <div class="card" style="padding:0; overflow:hidden;">
                <div style="padding: 15px 20px; border-bottom: 1px solid var(--border); display:flex; justify-content:space-between; align-items:center; gap:15px;">
                    <span style="font-weight: 800; font-size: 13px;">EVENT LOGS</span>
                    <div style="display:flex; gap:10px; flex:1; justify-content:flex-end;">
                        <select id="history-user-filter" class="input" style="width:180px; height:32px; font-size:11px;" onchange="updateStats()">
                            <option value="ALL">All Users</option>
                        </select>
                        <input type="text" id="history-search" class="input" placeholder="Search logs..." style="width:200px; height:32px; font-size:11px;">
                    </div>
                </div>
                <table>
                    <thead><tr><th>Time</th><th>Client</th><th>Event</th><th>Details</th><th>Action</th></tr></thead>
                    <tbody id="history-table"></tbody>
                </table>
            </div>
        </div>

        <!-- Security Tab -->
        <div id="tab-security" class="tab-content">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div class="card">
                    <div style="display:flex; justify-content:space-between; margin-bottom:15px;">
                        <h3 style="margin:0; font-size: 14px;">Whitelist</h3>
                        <label class="toggle"><input type="checkbox" id="wl-enabled" onchange="saveChanges()"><span class="slider"></span></label>
                    </div>
                    <div style="display:flex; gap:10px; margin-bottom:12px;">
                        <input type="text" id="wl-input" class="input" placeholder="IP or ID">
                        <button class="btn btn-primary" onclick="addToSecurity('wl')">Add</button>
                    </div>
                    <div id="wl-list"></div>
                </div>
                <div class="card">
                    <h3 style="margin:0 0 15px 0; font-size: 14px;">Blacklist</h3>
                    <div style="display:flex; gap:10px; margin-bottom:12px;">
                        <input type="text" id="ban-input" class="input" placeholder="IP or ID">
                        <button class="btn btn-primary" onclick="addToSecurity('ban')">Ban</button>
                    </div>
                    <div id="ban-list"></div>
                </div>
            </div>
        </div>

        <!-- Modpacks Tab -->
        <div id="tab-modpacks" class="tab-content">
            <div class="card">
                <h3 style="margin:0 0 15px 0; font-size: 14px;">Server Modpacks</h3>
                <div id="modpacks-list" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;"></div>
            </div>
        </div>

        <!-- Logs Tab -->
        <div id="tab-logs" class="tab-content">
            <div class="log-box" id="log-box"></div>
        </div>
    </div>

    <script>
        let adminPass = "";
        let currentData = null;
        let lastFullData = null;

        async function api(path, method = 'GET', body = null) {
            const opts = { method, headers: { 'Authorization': adminPass } };
            if (body) { opts.body = JSON.stringify(body); opts.headers['Content-Type'] = 'application/json'; }
            return fetch(path, opts).then(r => r.status === 401 ? null : r.json());
        }

        function showTab(id, e) {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.sidebar-item').forEach(i => i.classList.remove('active'));
            document.getElementById('tab-' + id).classList.add('active');
            e.target.classList.add('active');
        }

        async function refreshData() {
            const data = await api('/admin/data');
            if (!data) return false;
            currentData = data;
            renderSecurity();
            return true;
        }

        function renderSecurity() {
            const { whitelist, bans, repo } = currentData;
            document.getElementById('wl-enabled').checked = whitelist.enabled;
            
            document.getElementById('wl-list').innerHTML = [...whitelist.ips, ...whitelist.keys].map(v => {
                let row = '<div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid var(--border)">';
                row += '<span>' + v + '</span><button class="btn btn-sm btn-danger" onclick="removeItem(&quot;wl&quot;, &quot;' + v + '&quot;)">DEL</button>';
                row += '</div>';
                return row;
            }).join('');

            document.getElementById('ban-list').innerHTML = [...bans.banned_ips, ...bans.banned_keys].map(v => {
                let row = '<div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid var(--border)">';
                row += '<span>' + v + '</span><button class="btn btn-sm btn-danger" onclick="removeItem(&quot;ban&quot;, &quot;' + v + '&quot;)">UNBAN</button>';
                row += '</div>';
                return row;
            }).join('');
            
            const modpacks = repo && Array.isArray(repo.modpacks) ? repo.modpacks : [];
            document.getElementById('modpacks-list').innerHTML = modpacks.map((m, i) => {
                const mp = m.modpack || m;
                let row = '<div style="background:rgba(255,255,255,0.02); padding:12px; border-radius:10px; border:1px solid var(--border); display:flex; justify-content:space-between; align-items:center;">';
                row += '<div><div style="font-weight:700; font-size:12px;">' + (mp.name || 'Unnamed') + '</div>';
                row += '<div style="font-size:9px; color:var(--muted)">MODS: ' + (mp.mods ? mp.mods.length : 0) + ' | MODE: ' + (m.share_mode || 'public') + '</div></div>';
                row += '<label class="toggle"><input type="checkbox" ' + (m.enabled !== false ? 'checked' : '') + ' onchange="toggleModpack(' + i + ')"><span class="slider"></span></label>';
                row += '</div>';
                return row;
            }).join('');
        }

        async function addToSecurity(type, val = null) {
            const input = document.getElementById(type + '-input');
            const target = val || input.value.trim();
            if (!target) return;
            if (type === 'wl') { if (target.includes('.')) currentData.whitelist.ips.push(target); else currentData.whitelist.keys.push(target); }
            else { if (target.includes('.')) currentData.bans.banned_ips.push(target); else currentData.bans.banned_keys.push(target); }
            if (input) input.value = '';
            await saveChanges();
        }

        async function removeItem(type, val) {
            if (type === 'wl') {
                currentData.whitelist.ips = currentData.whitelist.ips.filter(v => v !== val);
                currentData.whitelist.keys = currentData.whitelist.keys.filter(v => v !== val);
            } else {
                currentData.bans.banned_ips = currentData.bans.banned_ips.filter(v => v !== val);
                currentData.bans.banned_keys = currentData.bans.banned_keys.filter(v => v !== val);
            }
            await saveChanges();
        }

        async function toggleModpack(idx) {
            const m = currentData.repo.modpacks[idx];
            m.enabled = m.enabled === undefined ? false : !m.enabled;
            await saveChanges();
        }

        async function saveChanges() {
            currentData.whitelist.enabled = document.getElementById('wl-enabled').checked;
            await api('/admin/update', 'POST', currentData);
            renderSecurity();
        }

        function formatBytes(b) {
            if (b < 1024) return b + ' B';
            if (b < 1048576) return (b / 1024).toFixed(1) + ' KB';
            return (b / 1048576).toFixed(1) + ' MB';
        }

        function formatUptime(ms) {
            const s = Math.floor(ms / 1000);
            const d = Math.floor(s / 86400);
            const h = Math.floor((s % 86400) / 3600);
            const m = Math.floor((s % 3600) / 60);
            const sec = s % 60;
            let str = '';
            if (d > 0) str += d + 'd ';
            if (h > 0) str += h + 'h ';
            if (m > 0) str += m + 'm ';
            if (sec > 0 || str === '') str += sec + 's';
            return str;
        }

        async function updateStats() {
            const data = await fetch('/monitoring.json').then(r => r.json());
            lastFullData = data;
            document.getElementById('stat-uptime').innerText = formatUptime(data.server.uptime);
            document.getElementById('stat-data').innerText = formatBytes(data.server.totalBytes);
            document.getElementById('stat-active').innerText = data.sessions.length;

            const sQuery = document.getElementById('session-search').value.toLowerCase();
            const hQuery = document.getElementById('history-search').value.toLowerCase();
            const hUserFilter = document.getElementById('history-user-filter').value;

            // Update User Filter Dropdown
            const filterSelect = document.getElementById('history-user-filter');
            const currentUsers = new Set();
            data.history.forEach(h => { if(h.ip) currentUsers.add(h.ip); if(h.creatorId && h.creatorId !== "UNKNOWN") currentUsers.add(h.creatorId); });
            
            // Only rebuild if count changed to avoid losing selection
            if (filterSelect.options.length !== currentUsers.size + 1) {
                const currentVal = filterSelect.value;
                filterSelect.innerHTML = '<option value="ALL">All Users</option>';
                Array.from(currentUsers).sort().forEach(u => {
                    const opt = document.createElement('option');
                    opt.value = u; opt.textContent = u;
                    filterSelect.appendChild(opt);
                });
                filterSelect.value = currentVal;
            }

            const filteredSessions = data.sessions.filter(s => s.ip.toLowerCase().includes(sQuery) || s.creatorId.toLowerCase().includes(sQuery));
            
            const filteredHistory = data.history.filter(h => {
                const matchQuery = h.ip.toLowerCase().includes(hQuery) || h.creatorId.toLowerCase().includes(hQuery) || h.event.toLowerCase().includes(hQuery) || h.details.toLowerCase().includes(hQuery);
                const matchUser = hUserFilter === 'ALL' || h.ip === hUserFilter || h.creatorId === hUserFilter;
                return matchQuery && matchUser;
            });

            const stab = document.getElementById('session-table');
            stab.innerHTML = filteredSessions.map(s => {
                const activeDl = data.active.find(dl => dl.ip === s.ip);
                const progress = data.server.totalRepoSize > 0 ? (s.bytes / data.server.totalRepoSize * 100) : 0;
                let row = '<tr>';
                row += '<td><div style="font-weight:700">' + s.ip + '</div><div style="font-size:9px; color:var(--muted)">ID: ' + s.creatorId + '</div></td>';
                row += '<td>' + (activeDl ? 'DL: ' + activeDl.file : 'IDLE') + '</td>';
                row += '<td><div style="font-weight:700">' + formatBytes(s.bytes) + ' (' + progress.toFixed(1) + '% of Repo)</div>';
                row += '<div class="progress-bg"><div class="progress-fill" style="width:' + Math.min(100, progress) + '%"></div></div></td>';
                row += '<td style="color:var(--success); font-weight:800">' + (activeDl ? formatBytes(activeDl.speed) + '/s' : '-') + '</td>';
                row += '<td><div style="display:flex; gap:6px;">';
                row += '<button class="btn btn-sm" onclick="inspectSession(&quot;' + s.ip + '&quot;)">INSPECT</button>';
                row += '<button class="btn btn-sm btn-danger" onclick="addToSecurity(&quot;ban&quot;, &quot;' + s.ip + '&quot;)">BAN</button>';
                row += '</div></td></tr>';
                return row;
            }).join('');

            document.getElementById('history-table').innerHTML = filteredHistory.map(h => {
                let row = '<tr>';
                row += '<td style="color:var(--muted); font-size:11px;">' + new Date(h.ts).toLocaleTimeString() + '</td>';
                row += '<td><div style="font-weight:700">' + h.ip + '</div><div style="font-size:9px; color:var(--muted)">ID: ' + h.creatorId + '</div></td>';
                row += '<td><span class="badge ' + (h.event === 'REJECTED' ? 'badge-danger' : 'badge-info') + '">' + h.event + '</span></td>';
                row += '<td style="font-size:11px; max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">' + h.details + '</td>';
                row += '<td><button class="btn btn-sm btn-danger" onclick="addToSecurity(&quot;ban&quot;, &quot;' + h.ip + '&quot;)">BAN</button></td>';
                row += '</tr>';
                return row;
            }).join('');
        }

        function inspectSession(ip) {
            const s = lastFullData.sessions.find(x => x.ip === ip);
            if (!s) return;
            document.getElementById('inspect-title').innerText = 'Session Inspector: ' + ip;
            const filesHtml = s.files.length ? s.files.map(f => '<div style="font-size:11px; margin-bottom:5px; word-break: break-all;">[OK] ' + f + '</div>').join('') : 'No files recorded yet.';
            
            let body = '<div style="margin-bottom:20px;">';
            body += '<div style="font-size:12px; color:var(--muted); margin-bottom:5px;">CLIENT CREATOR ID</div>';
            body += '<div style="font-weight:800; word-break: break-all;">' + s.creatorId + '</div></div>';
            body += '<div style="margin-bottom:20px;">';
            body += '<div style="font-size:12px; color:var(--muted); margin-bottom:5px;">SESSION DOWNLOADED DATA</div>';
            body += '<div style="font-weight:800; color:var(--accent)">' + formatBytes(s.bytes) + '</div></div>';
            body += '<div><div style="font-size:12px; color:var(--muted); margin-bottom:10px;">DOWNLOAD HISTORY</div>';
            body += '<div style="max-height:200px; overflow-y:auto; overflow-x:hidden; background:rgba(0,0,0,0.2); padding:10px; border-radius:8px; border:1px solid var(--border);">';
            body += filesHtml + '</div></div>';
            
            document.getElementById('inspect-body').innerHTML = body;
            document.getElementById('inspector-modal').style.display = 'flex';
        }

        function closeModal() { document.getElementById('inspector-modal').style.display = 'none'; }

        async function fetchLogs() {
            const logs = await api('/admin/logs');
            if (logs) {
                const box = document.getElementById('log-box');
                const scroll = box.scrollHeight - box.scrollTop <= box.clientHeight + 50;
                box.innerHTML = logs.lines.map(l => '<div style="margin-bottom:2px">' + l + '</div>').join('');
                if (scroll) box.scrollTop = box.scrollHeight;
            }
        }

        async function login() {
            const pw = document.getElementById('admin-pass').value;
            adminPass = pw;
            const ok = await refreshData();
            if (ok) {
                localStorage.setItem('bmm_token', pw);
                document.getElementById('auth-overlay').style.display = 'none';
                updateStats();
                setInterval(updateStats, 2000);
                setInterval(fetchLogs, 2000);
            } else {
                alert('Invalid Password');
            }
        }

        const savedToken = localStorage.getItem('bmm_token');
        if (savedToken) {
            document.getElementById('admin-pass').value = savedToken;
            login();
        }
    </script>
</body>
</html>
