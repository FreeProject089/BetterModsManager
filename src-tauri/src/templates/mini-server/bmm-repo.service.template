# BMM standalone repo server, as a systemd service. Generated by BMM.
#
#   1. Copy the server folder to /srv/bmm-repo (or change WorkingDirectory below).
#   2. sudo useradd --system --home /srv/bmm-repo --shell /usr/sbin/nologin bmm
#      sudo chown -R bmm:bmm /srv/bmm-repo
#   3. sudo cp bmm-server/bmm-repo.service /etc/systemd/system/
#      sudo systemctl daemon-reload && sudo systemctl enable --now bmm-repo
#   4. journalctl -u bmm-repo -f        curl http://127.0.0.1:{{PORT}}/health
{{PREPARE_NOTE}}
[Unit]
Description=BMM standalone repo server (port {{PORT}})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bmm
Group=bmm
WorkingDirectory=/srv/bmm-repo
ExecStart=/usr/bin/env node {{ENTRY}}
Environment=NODE_ENV=production
Environment=PORT={{PORT}}
# Environment=BMM_PUBLIC_URL=https://repo.example.com
# Environment=BMM_RATE_LIMIT=600
Restart=on-failure
RestartSec=5
# Let a download in progress finish on stop (the server closes gracefully on SIGTERM).
TimeoutStopSec=15

# Hardening: the server only writes inside its own folder.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/bmm-repo

[Install]
WantedBy=multi-user.target
