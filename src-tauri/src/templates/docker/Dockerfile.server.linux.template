# BMM Express Server - Docker Image (Linux)
# Node.js 22 LTS (Node 20 reached end of life in April 2026), pinned by version AND digest so
# a rebuild gets the same image. To bump: pick the new tag on hub.docker.com/_/node, then
# `docker pull node:<tag>` and `docker inspect --format "{{index .RepoDigests 0}}" node:<tag>`.
FROM node:22.23.3-alpine3.24@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Create app directory
WORKDIR /app

# Copy package manifest first for layer caching
COPY package.json ./

# Install production dependencies only
RUN npm install --omit=dev

# Copy application files
COPY server.js ./
COPY public/ ./public/

# Copy repository data files
COPY mods/ ./mods/
COPY repo.json ./
COPY Info.json ./

# Create non-root user for security
RUN addgroup -g 1001 -S bmm && \
    adduser -S bmm -u 1001 -G bmm && \
    chown -R bmm:bmm /app

USER bmm

# Expose configured port
EXPOSE PORT_PLACEHOLDER

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:PORT_PLACEHOLDER/repo.json', (r) => { process.exit(r.statusCode === 200 ? 0 : 1) })"

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server.js"]
